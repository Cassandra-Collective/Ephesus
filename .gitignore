# No trailing slash: with one the pattern matches only a directory, and git
# does not follow a symlink, so on linux and macOS a linked node_modules
# (TEST-STRATEGY §10 runs a mutation round from a worktree with one) would show
# as untracked and the round would refuse to start (DECISIONS-LOG 2026-10-11).
node_modules
dist/
out/
.DS_Store
*.local
.env
.env.*

# Licensed art drop (UI-DESIGN §7, see src/renderer/src/assets/ATTRIBUTION.md).
# The SHEETS are the licensed asset and never enter the repository. The
# `*.tiles.json` maps are not: a layout is our own work — a table of integers
# describing where things sit on somebody else's sheet — and committing it is
# what makes ATTRIBUTION's restore path reproducible rather than a story.
src/renderer/src/assets/tileset/*
!src/renderer/src/assets/tileset/.gitkeep
!src/renderer/src/assets/tileset/*.tiles.json
# Same rule, same reason: an emote table is a map from phases to frame
# indices on somebody else's sheet — our work, not theirs.
!src/renderer/src/assets/tileset/*.emotes.json
src/renderer/public/fonts/*
!src/renderer/public/fonts/README.md

# Licensed character art (ATTRIBUTION rule 3, rewritten 2026-09-01). Same rule
# as the tileset: the SHEETS are the licensed asset and never enter the
# repository; the manifest that says how to read them is our own work and does.
src/renderer/src/assets/characters/*
!src/renderer/src/assets/characters/.gitkeep
!src/renderer/src/assets/characters/*.chars.json

# Coverage reports (M8.0): regenerated by `npm run test:coverage`; the record that
# matters is scripts/coverage-floors.json, which IS committed.
coverage/
