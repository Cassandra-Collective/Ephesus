---
import '../styles/fonts.css'
import '../styles/tokens.css'
import Mark from '../components/Mark.astro'
interface Props {
  title: string
  description: string
  article?: { date: Date; tag: string }
}
const { title, description, article } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'

// Astro.site comes from astro.config.mjs. Emitting it is what makes the config
// do anything — without a canonical link and og:url, setting `site` changes
// nothing about the built output.
//
// The trailing slash is stripped because vercel.json sets trailingSlash:false.
// A canonical that points at a URL which redirects is a canonical that argues
// with the server.
// Two normalisations, and both are needed for the canonical to name the URL the
// server actually serves:
//
//   .html   build.format is 'file', so the built path is /compare.html — but
//           vercel.json sets cleanUrls, which serves /compare and REDIRECTS
//           /compare.html to it. A canonical pointing at the .html form points
//           at a redirect, and Google follows canonicals.
//   slash   vercel.json also sets trailingSlash:false.
//
// The root is the exception: it stays "/" so it matches the sitemap entry.
const clean = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/'
const canonical = new URL(clean, Astro.site).href
const ogImage = new URL('/img/social-card.png', Astro.site).href
const siteHome = new URL('/', Astro.site).href

// A page's on-screen summary and its search snippet want different lengths, so
// they are derived rather than shared. Google truncates a description past ~160
// characters and a title past ~60; neither is a penalty, but a snippet that ends
// mid-word reads as carelessness. Cutting at a sentence boundary keeps the
// snippet a complete thought.
function snippet(s: string, max = 158): string {
  if (s.length <= max) return s
  const cut = s.slice(0, max + 1)
  const stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('? '), cut.lastIndexOf('! '))
  if (stop > 70) return s.slice(0, stop + 1)
  return s.slice(0, cut.lastIndexOf(' ')) + '…'
}
const metaDescription = snippet(description)

// The " — Ephesus" suffix costs ten characters. On a long headline that pushes
// the title past what is displayed, and search engines append the site name
// themselves, so it is dropped rather than truncated.
const metaTitle = title.length > 62 ? title.replace(/ — Ephesus$/, '') : title

// Structured data. BlogPosting is what earns a rich result for the posts; the
// site-level object identifies the software the whole thing is about.
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title.replace(/ — Ephesus$/, ''),
      description: metaDescription,
      datePublished: article.date.toISOString(),
      dateModified: article.date.toISOString(),
      articleSection: article.tag,
      image: ogImage,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      author: { '@type': 'Person', name: 'Mert Efe Şensoy' },
      publisher: { '@type': 'Organization', name: 'Ephesus', url: siteHome },
      isAccessibleForFree: true,
      license: 'https://opensource.org/licenses/MIT'
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Ephesus',
      url: siteHome,
      description: metaDescription,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      license: 'https://opensource.org/licenses/MIT',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Mert Efe Şensoy' },
      codeRepository: 'https://github.com/Cassandra-Collective/Ephesus',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
    }
const nav = [
  { href: '/compare',    label: 'Compare' },
  { href: '/city',       label: 'The City' },
  { href: '/roadmap',    label: 'Roadmap' },
  { href: '/contribute', label: 'Contribute' },
  { href: '/blog',       label: 'Writing' }
]
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription}>
  <link rel="canonical" href={canonical}>

  <!-- Icons. The SVG scales to whatever size a browser asks for; the PNGs cover
       the ones that will not take SVG, and apple-touch-icon covers iOS home
       screens. theme-color is ink-900, which is the header border and the mark's
       own keyline.

       The .ico and the 192px PNG lead because Google's favicon crawler takes
       neither SVG (not in its supported list: BMP, GIF, ICO, PNG, JPEG, PPM,
       TIFF) nor the web app manifest, and it wants an icon larger than 48px.
       Browsers still choose the SVG, which they select on type rather than on
       document order. The 16 and 32 PNG links are byte-identical to two of the
       .ico's three frames; they stay so those files keep a referrer. -->
  <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16">
  <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#221A14">
  <meta property="og:title" content={metaTitle}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:type" content={article ? 'article' : 'website'}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="Ephesus — an agent company you govern as its architect">
  <meta property="og:site_name" content="Ephesus">
  <meta property="og:locale" content="en_GB">
  {article && <meta property="article:published_time" content={article.date.toISOString()} />}
  {article && <meta property="article:section" content={article.tag} />}
  {article && <meta property="article:author" content="Mert Efe Şensoy" />}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={metaTitle}>
  <meta name="twitter:description" content={metaDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="author" content="Mert Efe Şensoy">
  <link rel="alternate" type="application/rss+xml" title="Ephesus — notes from the build" href="/rss.xml">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <!-- Pages may contribute additional structured data (a FAQPage, for instance).
       This slot has to exist or a `slot="head"` in a child renders nowhere and
       fails silently — which is exactly what happened the first time. -->
  <slot name="head" />

  <!-- Google Analytics with Consent Mode v2, DENIED BY DEFAULT.
       No cookies are written and no identifiers are sent unless consent is
       granted, so this needs no banner: Google receives only anonymous,
       aggregated pings. Google's own setup screen points EEA operators here.
       The defaults are set before gtag.js loads — order matters, because a
       consent default applied after the tag has fired is a consent default
       that did nothing. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || []
    function gtag() { dataLayer.push(arguments) }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted'
    })
    gtag('js', new Date())
    gtag('config', 'G-RFSCBBKQT5', { anonymize_ip: true })
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RFSCBBKQT5"></script>
  <!-- Vercel Web Analytics: Tracks page views, unique visitors, and referrers.
       The inject() function loads a 1.1kb script from /_vercel/insights/script.js
       when deployed to Vercel. -->
  <script>
    import { inject } from '@vercel/analytics';
    inject();
  </script>
  <!-- Fonts are self-hosted (src/styles/fonts.css). The two faces that paint
       first are preloaded; the rest arrive on demand via unicode-range. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-400-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/press-start-2p-400-latin.woff2" crossorigin>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">
        <Mark size={34} />
        <span>Ephesus</span>
      </a>
      <nav>
        {nav.map(n => (
          <a href={n.href} class={path.startsWith(n.href) ? 'on' : ''}>{n.label}</a>
        ))}
        <a href="https://github.com/Cassandra-Collective/Ephesus" class="gh">GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1"><slot /></main>

  <footer class="site">
    <div class="wrap">
      <div class="fgrid">
        <div>
          <Mark size={44} />
          <p class="fnote">A multi-agent harness you govern as its architect. Pre-alpha, MIT licensed, built in the open.</p>
        </div>
        <div>
          <h4>This site</h4>
          <a href="/compare">How it compares</a>
          <a href="/record">The build record</a>
          <a href="/about">About &amp; the wall</a>
          <a href="/blog">Writing</a>
          <a href="/rss.xml">RSS feed</a>
        </div>
        <div>
          <h4>Project</h4>
          <a href="https://github.com/Cassandra-Collective/Ephesus">Source</a>
          <a href="https://github.com/Cassandra-Collective/Ephesus/tree/main/docs">Design suite</a>
          <a href="https://github.com/Cassandra-Collective/Ephesus/labels/good%20first%20issue">Good first issues</a>
          <a href="https://github.com/Cassandra-Collective/Ephesus/blob/main/CONTRIBUTING.md">Contributing guide</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
      <p class="lineage">An original work inspired by the MIT-licensed <a href="https://github.com/chaitanyagiri/munder-difflin">Munder Difflin</a>; patterns reused with attribution, no upstream code vendored. Floor art from the LimeZu packs, licensed and kept out of the repository.</p>
    </div>
  </footer>

  <style is:global>
    /* Skip link: off-screen until focused, then it lands over the header.
       Keyboard users hit it first; nobody else ever sees it. */
    .skip{
      position:absolute;left:-9999px;top:0;z-index:60;border:0;
      background:var(--ink);color:var(--paper);font-family:var(--mono);
      font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:12px 18px;
    }
    .skip:focus{left:0;color:var(--paper)}
    main:focus{outline:none}

    header.site{border-bottom:2px solid var(--ink);background:#FBF9F4;position:sticky;top:0;z-index:20}
    header.site .bar{display:flex;align-items:center;justify-content:space-between;gap:20px;height:64px}
    .brand{display:flex;align-items:center;gap:12px;border:0;color:var(--ink);font-weight:600;font-size:17px}
    .brand:hover{color:var(--terracotta)}
    header nav{display:flex;gap:22px;align-items:center;flex-wrap:wrap}
    header nav a{border:0;color:var(--ink-2);font-size:14.5px}
    header nav a:hover,header nav a.on{color:var(--terracotta)}
    header nav a.on{box-shadow:0 2px 0 0 var(--terracotta)}
    header nav a.gh{font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;
      border:2px solid var(--ink);padding:7px 13px;box-shadow:2px 2px 0 0 var(--ink);color:var(--ink)}
    header nav a.gh:hover{background:var(--ink);color:var(--paper)}
    /* Mobile: the nav cannot wrap inside a fixed-height header without
       overflowing it — items disappeared and the GitHub button escaped the
       border. Below 780px the header becomes two rows and the nav is a
       horizontally scrollable strip, which needs no JavaScript and no menu. */
    @media (max-width: 780px){
      header.site .bar{
        height:auto; flex-direction:column; align-items:stretch; gap:0; padding:10px 0 0;
      }
      header.site nav{
        flex-wrap:nowrap; overflow-x:auto; gap:18px;
        padding:10px 0 12px; margin-top:8px;
        border-top:1px solid var(--paper-3);
        scrollbar-width:none;
      }
      header.site nav::-webkit-scrollbar{display:none}
      header.site nav a{white-space:nowrap}
      header.site nav a.gh{padding:6px 11px;box-shadow:2px 2px 0 0 var(--ink)}
    }
    footer.site{border-top:2px solid var(--ink);background:#FBF9F4;padding:44px 0 34px;margin-top:20px}
    .fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px}
    @media(max-width:720px){.fgrid{grid-template-columns:1fr}}
    footer h4{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin:0 0 10px;font-weight:400}
    footer .fgrid a{display:block;border:0;color:var(--ink-2);font-size:15px;padding:3px 0}
    footer .fgrid a:hover{color:var(--terracotta)}
    .fnote{font-size:14.5px;color:var(--ink-3);margin:14px 0 0;max-width:34ch}
    .lineage{font-size:13px;color:var(--ink-3);margin:30px 0 0;padding-top:18px;border-top:1px solid var(--paper-3);max-width:76ch}
  </style>
</body>
</html>
