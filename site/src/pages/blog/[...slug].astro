---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)

// Related posts: same tag first, then most recent. The seven posts are one
// argument told seven ways, so linking them is not decoration — it is the
// topic cluster, and it is the strongest on-site signal available.
const all = (await getCollection("blog")).filter((p) => p.id !== post.id)
const sameTag = all.filter((p) => p.data.tag === post.data.tag)
const rest = all.filter((p) => p.data.tag !== post.data.tag)
const related = [...sameTag, ...rest]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<Base
  title={`${post.data.title} — Ephesus`}
  description={post.data.summary}
  article={{ date: post.data.date, tag: post.data.tag }}>
  <article>
    <header class="phead">
      <div class="wrap narrow">
        <div class="pmeta">
          <span class="ptag">{post.data.tag}</span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <span>{post.data.reading}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.summary}</p>
      </div>
    </header>

    <div class="wrap narrow body">
      <Content />

      <aside class="related">
        <h2>Related</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/blog/${r.id}`}>{r.data.title}</a>
              <span>{r.data.summary}</span>
            </li>
          ))}
        </ul>
      </aside>

      <div class="btnrow">
        <a class="btn" href="/blog">All writing</a>
        <a class="btn" href="https://github.com/Cassandra-Collective/Ephesus">The repository</a>
      </div>
    </div>
  </article>

  <style>
    .phead { padding: 58px 0 34px; border-bottom: 1px solid var(--paper-3); }
    .pmeta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
    .ptag {
      font-family: var(--pixel); font-size: 8px; letter-spacing: .1em; text-transform: uppercase;
      color: #FBF9F4; background: var(--terracotta); padding: 5px 8px; line-height: 1;
    }
    .pmeta time, .pmeta span:last-child { font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); }
    .body { padding: 40px 0 30px; font-size: 18px; }
    .body :global(h2) { margin-top: 42px; font-size: 25px; }
    .body :global(h3) { margin-top: 30px; font-size: 19px; }
    .body :global(p) { max-width: none; }
    .body :global(ul), .body :global(ol) { max-width: none; padding-left: 22px; }
    .body :global(li) { margin-bottom: 9px; }
    .body :global(hr) { border: 0; border-top: 1px solid var(--paper-3); margin: 40px 0; }
    .body :global(blockquote) { font-size: 20px; }
    .body :global(table) { margin: 24px 0; }
    .body :global(td:first-child) { color: var(--ink); font-weight: 400; white-space: normal; }
    .related { margin-top: 52px; border-top: 2px solid var(--ink); padding-top: 26px; }
    .related h2 {
      font-family: var(--mono); font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
      color: var(--ink-3); font-weight: 400; margin: 0 0 16px;
    }
    .related ul { list-style: none; padding: 0; margin: 0; }
    .related li { padding: 14px 0; border-bottom: 1px solid var(--paper-3); }
    .related li:last-child { border-bottom: 0; }
    .related a { display: block; font-weight: 600; font-size: 17px; border: 0; }
    .related span { display: block; color: var(--ink-3); font-size: 15px; margin-top: 4px; }
  </style>
</Base>
